{
  "enabled": true,
  "name": "Auto Commit Changes",
  "description": "Commits all changes with a short, human commit message in present tense, imperative mood (e.g., \"add yaml parser\", \"fix diff bug\") after completing a task.",
  "version": "1",
  "when": {
    "type": "agentEnd"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review all the changes made during this session. Run `git add -A` to stage all changes, then commit them with `git commit -m \"message\"`. Write a short, descriptive commit message in present tense, imperative mood (e.g., \"add yaml parser\", \"fix diff bug\"). Keep it concise and human-readable. Do not ask for confirmation, just commit the changes."
  }
}